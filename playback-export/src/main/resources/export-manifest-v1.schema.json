{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citac-knjiga.local/schemas/export-manifest-v1.schema.json",
  "title": "citac-knjiga export manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "book", "source", "duration_unit", "chapters", "attribution_refs"],
  "properties": {
    "schema": { "$ref": "#/$defs/schema" },
    "book": { "$ref": "#/$defs/book" },
    "source": { "$ref": "#/$defs/source" },
    "duration_unit": { "const": "milliseconds" },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/chapter" }
    },
    "attribution_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attribution" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": { "id": { "const": "citac-knjiga-export-manifest" }, "version": { "const": 1 } }
    },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "total_duration_ms"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "total_duration_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "encoding", "value"],
      "properties": {
        "algorithm": { "const": "sha-256" },
        "encoding": { "const": "lowercase-hex" },
        "value": { "$ref": "#/$defs/hash" }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "title", "duration_ms", "files"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "path", "media_type", "sha256", "size_bytes", "duration_ms", "sample_rate_hz", "channels", "generation"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 0 },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:#?])[^\\u0000]+$" },
        "media_type": { "enum": ["audio/mp4", "audio/mp4a-latm", "audio/wav"] },
        "sha256": { "$ref": "#/$defs/hash" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "sample_rate_hz": { "const": 24000 },
        "channels": { "const": 1 },
        "generation": { "$ref": "#/$defs/generation" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_key", "model_package_sha256", "voice_sha256", "preprocessing_version", "pronunciation_version", "inference_settings_hash", "audio_processing_version"],
      "properties": {
        "generation_key": { "$ref": "#/$defs/hash" },
        "model_package_id": { "$ref": "#/$defs/id" },
        "model_package_sha256": { "$ref": "#/$defs/hash" },
        "voice_sha256": { "$ref": "#/$defs/hash" },
        "preprocessing_version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]*$" },
        "pronunciation_version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]*$" },
        "inference_settings_hash": { "$ref": "#/$defs/hash" },
        "audio_processing_version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]*$" }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "source_url", "license_id", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subject": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "license_id": { "$ref": "#/$defs/id" },
        "required": { "type": "boolean" }
      }
    }
  }
}
