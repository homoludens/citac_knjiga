{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "gates", "outcome"],
  "properties": {
    "schema": {"const": "serbian-vits-gate-record:1"},
    "gates": {"type": "array", "minItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["id", "result", "evidence", "reason"], "properties": {"id": {"type": "string"}, "result": {"enum": ["PASS", "FAIL", "UNRESOLVED"]}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "reason": {"type": ["string", "null"]}}}},
    "outcome": {"enum": ["ACCEPTED", "REJECTED"]}
  }
}
